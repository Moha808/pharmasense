rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER FUNCTIONS & ROLE CHECKS
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getUserRole() {
      return isAuthenticated() && (
        request.auth.token.role != null ? request.auth.token.role : getUserData().role
      );
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    
    function isStaff() {
      return isAuthenticated() && getUserRole() == 'staff';
    }
    
    function isAdminOrStaff() {
      return isAdmin() || isStaff();
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // USERS COLLECTION
    // Admin has full CRUD. Staff can read own doc.
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone']));
      allow delete: if false; // Soft-delete only
    }

    // ==========================================
    // CATEGORIES COLLECTION
    // Read: authenticated users. Write: Admin only.
    // ==========================================
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if false; // Soft-delete only
    }

    // ==========================================
    // MEDICINES COLLECTION
    // Read: authenticated users. Write: Admin only.
    // ==========================================
    match /medicines/{medicineId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if false; // Soft-delete only
    }

    // ==========================================
    // BATCHES COLLECTION
    // Read: authenticated users.
    // Write: Admin only (stock-in, adjustment) or transactional sale deduction.
    // ==========================================
    match /batches/{batchId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      // Allow update if admin OR if staff during a sale decreasing quantityRemaining
      allow update: if isAdmin() || (
        isAdminOrStaff() && 
        request.resource.data.quantityRemaining <= resource.data.quantityRemaining
      );
      allow delete: if false;
    }

    // ==========================================
    // SUPPLIERS COLLECTION
    // Admin full access. Staff no access.
    // ==========================================
    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // STOCK MOVEMENTS COLLECTION
    // Admin can read all. Staff and admin can write during inventory changes/sales.
    // ==========================================
    match /stockMovements/{movementId} {
      allow read: if isAdmin();
      allow create: if isAdminOrStaff();
      allow update, delete: if false; // Immutable audit log
    }

    // ==========================================
    // SALES COLLECTION
    // Admin can read all. Staff can create sale and read own sales.
    // ==========================================
    match /sales/{saleId} {
      allow read: if isAdmin() || (isStaff() && resource.data.cashierId == request.auth.uid);
      allow create: if isAdminOrStaff() && request.resource.data.cashierId == request.auth.uid;
      allow update: if isAdmin(); // Admin only for returns/adjustments
      allow delete: if false;
    }

    // ==========================================
    // AUDIT LOGS COLLECTION
    // Admin read only. Server/authenticated create (append-only).
    // ==========================================
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Strictly immutable
    }

    // ==========================================
    // SETTINGS COLLECTION
    // Read: Admin or Staff. Write: Admin only.
    // ==========================================
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
